PORT=4000
ISSUER=http://localhost:4000

# Where the two relying parties are actually reachable — used to register their
# OIDC redirect/logout URIs. Point these at real hosted URLs in production.
STOREFRONT_PUBLIC_URL=http://localhost:4001
DASHBOARD_PUBLIC_URL=http://localhost:4002
# Must match demo-storefront's/dashboard's own CLIENT_SECRET env var, respectively.
STOREFRONT_CLIENT_SECRET=storefront_secret_dev_only
DASHBOARD_CLIENT_SECRET=dashboard_secret_dev_only

DATABASE_URL=postgres://idp:idp_pw@localhost:55432/idp_sessions

LDAP_URL=ldap://localhost:3890
LDAP_USER_BASE=ou=People,dc=adsso,dc=local
LDAP_GROUP_BASE=ou=Groups,dc=adsso,dc=local
LDAP_READER_DN=cn=admin,dc=adsso,dc=local
LDAP_READER_PASSWORD=AdminPass123

COOKIE_SECRET=poc-cookie-secret-dev-only
LOGOUT_TOKEN_SECRET=poc-shared-logout-secret-dev-only
